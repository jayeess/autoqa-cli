# ---------------------------------------------------------------------------
# AutoQA Dashboard — environment variables
# Copy this file to `.env.local` (or paste into Render's dashboard env panel)
# and fill in the values from your Supabase project.
#
# These are PUBLIC keys — they are bundled into the client-side build via
# the NEXT_PUBLIC_ prefix. The CLI uses the SERVICE ROLE key to WRITE data;
# the dashboard uses the ANON key to READ it. Make sure Row-Level Security
# is configured on `test_matrices` and `bug_reports` to allow `select` for
# the `anon` role (or disable RLS on those tables for portfolio demos).
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
