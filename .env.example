# ---------------------------------------------------------------------------
# AutoQA CLI — environment variables
# Copy this file to `.env` and fill in the values you need.
# ---------------------------------------------------------------------------

# Claude API key (required for `autoqa write-tests`)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override default Claude model
# ANTHROPIC_MODEL=claude-opus-4-6

# ---------------------------------------------------------------------------
# Supabase (required when running any command with --push-supabase)
# Create a project at https://supabase.com and grab these from
# Project Settings → API.
#
# IMPORTANT: Use the SERVICE ROLE key (not the anon key). This CLI runs as a
# trusted backend utility and needs to bypass Row-Level Security to insert
# rows into the test_matrices table. NEVER commit this key or ship it to a
# browser / public web bundle.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
